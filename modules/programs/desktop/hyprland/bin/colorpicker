#!/bin/sh
# Colour picker. Bound to SUPER + C (hex) and SUPER + Shift + C (rgb).
#
# A thin wrapper around hyprpicker, which freezes the
# screen, shows a zoom lens and prints whatever pixel you click. This script is
# the part hyprpicker does not do: putting the value on the clipboard in the
# format you asked for, and showing it back to you with a swatch.
#
# hyprpicker has its own --autocopy and --notify, and neither is used:
# --autocopy can only copy the format hyprpicker picked in, and appends a
# newline while doing it (see the wl-copy comment), and --notify reports the
# value as text where the swatch below shows the colour itself.

set -eu

case "${1:-hex}" in
hex) format=hex ;;
rgb) format=rgb ;;
*)
  echo "usage: ${0##*/} [hex|rgb]" >&2
  exit 2
  ;;
esac

if ! command -v hyprpicker >/dev/null 2>&1; then
  notify-send -a 'Colour picker' -u critical \
    'hyprpicker is not installed' 'add it to hyprland/home.nix'
  exit 1
fi

# Always picked as hex, whatever was asked for: hyprpicker emits one format per
# run, and hex is the one the rest of this script can convert from and paint a
# swatch with. rgb is derived below.
#
#   -b  no "fancy" output. Without it the colour is wrapped in ANSI escapes
#       (\033[38;2;...m) -- fine in a terminal, but this runs from a keybind
#       and those bytes would go straight onto the clipboard.
#   -l  lowercase hex, which is what colors.lua and the stylesheets use.
#   -r  freeze the inactive displays too, so a hover state or a video on the
#       other screen holds still while you aim.
#   -q  quiet; only errors reach the journal.
#
# Escape leaves hyprpicker non-zero with nothing on stdout, hence the `|| exit`
# rather than letting `set -e` kill the script mid-pick.
hex=$(hyprpicker -f hex -b -l -r -q) || exit 0
[ -n "$hex" ] || exit 0

# Guards the clipboard: anything that is not exactly #rrggbb is a hyprpicker
# that changed its output, not a colour, and is not worth pasting.
case "$hex" in
'#'[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
*)
  notify-send -a 'Colour picker' -u critical \
    'Unexpected output from hyprpicker' "$hex"
  exit 1
  ;;
esac

if [ "$format" = rgb ]; then
  digits=${hex#\#}
  rest=${digits#??}
  value=$(printf 'rgb(%d, %d, %d)' \
    "0x${digits%????}" "0x${rest%??}" "0x${digits#????}")
else
  value=$hex
fi

# Our own wl-copy rather than hyprpicker --autocopy, for two reasons: autocopy
# would copy the hex even when rgb was asked for, and it appends a newline, so
# pasting into a config file also presses Enter.
#
# Either way the pick lands in cliphist and comes back under SUPER + Shift + V.
printf '%s' "$value" | wl-copy

# A swatch, so a colour picked out of a screenshot is recognisable in the
# notification instead of being six characters of hex. ImageMagick draws it;
# without it the notification still fires, just without the picture.
#
# The border matters more than it looks: a swatch close to the notification's
# own background (Catppuccin base, #1e1e2e) would otherwise have no visible
# edge at all. surface2 reads against both ends of the palette.
icon=''
if command -v magick >/dev/null 2>&1; then
  cache=${XDG_CACHE_HOME:-$HOME/.cache}/colorpicker
  mkdir -p "$cache"
  icon=$cache/swatch.png
  magick -size 96x96 "xc:$hex" -bordercolor '#585b70' -border 4 "png:$icon" ||
    icon=''
fi

# x-canonical-private-synchronous replaces the previous swatch instead of
# stacking one notification per pick; swaync honours it.
set -- -a 'Colour picker' -h string:x-canonical-private-synchronous:colorpicker
if [ -n "$icon" ]; then
  set -- "$@" -i "$icon"
fi

exec notify-send "$@" "$value" 'Copied to clipboard'
