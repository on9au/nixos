#!/bin/sh
# server-mode on|off -- keep the machine running for its servers with the
# screens, lights, sound and the monitors' USB (keyboard and mouse included)
# off, until the power button is pressed.
#
# `on` is in the power menu, `off` is the XF86PowerOff bind in binds.lua.
#
# The server-mode user unit holds a logind handle-power-key inhibitor, so the
# button reaches that bind instead of shutting down. It also turns the screens
# back off whenever something turns them on: they have woken by themselves
# after a DisplayPort hotplug with DPMS off, and stopping hypridle alone
# doesn't rule out Hyprland doing that. If Hyprland goes away the unit exits,
# and the power button shuts down again.

set -eu

unit=server-mode
saved="${XDG_RUNTIME_DIR:?}/server-mode"

screens() {
  hyprctl dispatch "hl.dsp.dpms({action = \"$1\"})" >/dev/null
}

sink() {
  wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null |
    sed -n 's/.*node\.name = "\(.*\)"/\1/p'
}

# devices/monitor-usb-hub.nix, on the desktop: the monitors' USB hub, with the
# keyboard, mouse, webcam and IEMs behind it. Absent elsewhere.
usb() {
  if systemctl cat monitor-usb-off.service >/dev/null 2>&1; then
    systemctl "$1" monitor-usb-off.service || true
  fi
}

on() {
  [ -d "$saved" ] && exit 0

  loginctl lock-session
  # hyprlock is hypridle's lock_cmd and runs in hypridle's scope, so kill the
  # hypridle process alone, once hyprlock is up: stopping the scope, or
  # killing hypridle first, would leave the session unlocked.
  i=0
  until pidof hyprlock >/dev/null; do
    [ $i -lt 50 ] || exit 1
    sleep 0.1
    i=$((i + 1))
  done
  pkill -x hypridle || true

  mkdir -p "$saved"
  powerprofilesctl get >"$saved/profile"
  # Not power-saver: the clocks it holds down cost the game servers ticks.
  # CoolerControl maps balanced to its Quiet fan mode (set in its Modes page).
  powerprofilesctl set balanced
  wpctl get-volume @DEFAULT_AUDIO_SINK@ >"$saved/volume"
  sink >"$saved/sink"
  wpctl set-mute @DEFAULT_AUDIO_SINK@ 1
  # Before the hub goes: the keyboard and mouse are on it.
  if command -v rgb-state >/dev/null; then
    rgb-state save && rgb-state off || true
  fi

  systemd-run --user --unit="$unit" --collect --quiet -- \
    systemd-inhibit --what=handle-power-key --who="server mode" \
    --why="The power button leaves server mode" --mode=block \
    "$HOME/.local/bin/server-mode" hold
  # Only once the power button is held for leaving: with the keyboard gone
  # it's the one way out.
  usb start
  screens off
}

hold() {
  # hyprctl fails once Hyprland has gone, which ends the loop.
  while monitors=$(hyprctl monitors); do
    case $monitors in
    *'dpmsStatus: 1'*) screens off ;;
    esac
    sleep 5
  done
}

off() {
  [ -d "$saved" ] || exit 0

  systemctl --user stop "$unit" 2>/dev/null || true
  usb stop
  screens on
  powerprofilesctl set "$(cat "$saved/profile")"
  # The way autostart.lua starts it.
  pidof hypridle >/dev/null ||
    hyprctl dispatch 'hl.dsp.exec_cmd("uwsm app -- hypridle")' >/dev/null

  # If the default output was the IEMs' adapter, it comes back muted with the
  # hub; wait for it to be the default again before unmuting.
  i=0
  until [ "$(sink)" = "$(cat "$saved/sink")" ] || [ $i -ge 50 ]; do
    sleep 0.2
    i=$((i + 1))
  done
  case $(cat "$saved/volume") in
  *MUTED*) ;;
  *) wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 ;;
  esac
  # Last: it waits for the keyboard and mouse to be found again.
  if command -v rgb-state >/dev/null; then
    rgb-state restore || true
  fi
  rm -r "$saved"
}

case "${1:-}" in
on) on ;;
off) off ;;
hold) hold ;;
*)
  echo "usage: server-mode on|off" >&2
  exit 2
  ;;
esac
