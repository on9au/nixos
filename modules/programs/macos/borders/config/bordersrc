#!/bin/sh
# JankyBorders -- macOS-only, closest analog to Hyprland's active/inactive
# window border in ../hypr/looknfeel.lua. Values below are ported directly
# from there (same Catppuccin Mocha hex, same alpha, same border_size).
#
# The mauve->blue 45-degree gradient on the focused window is close enough to
# a literal port: JankyBorders' gradient() takes corners, not an angle, but
# top_left->bottom_right is the same diagonal Hyprland's angle=45 draws.
# There's no macOS equivalent of the blur-behind-the-border effect --
# compositing doesn't expose that at the window-border level here.

borders \
  style=round \
  width=2.0 \
  hidpi=on \
  active_color="gradient(top_left=0xeecba6f7,bottom_right=0xee89b4fa)" \
  inactive_color=0xaa313244
